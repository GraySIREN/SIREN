<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale= 1.0">
    <title>CAD Creations</title>
    <link rel="stylesheet" href="/css/3d_creations.css">
</head>

<body>
    <div class="card-carousel">
        <h2 class="mb-4">CAD Creations Gallery</h2>

        @* Generate 3 Rows *@
        @for (int i = 1; i <= 3; i++)
        {
            <div class="row-wrapper mb-5">
                <h4 class="text-muted mb-3">Category @i</h4>

                @* The scrollable container *@
                <div class="card-carousel d-flex flex-nowrap overflow-auto shadow-sm p-3 bg-light rounded">

                    @* Generate 9 Columns/Items per row *@
                    @for (int j = 1; j <= 9; j++)
                    {
                        <div class="card-item mx-2" style="min-width: 200px;">
                            <div class="card h-100">
                                <img src="https://placehold.co/300x200?text=CAD+Model+@j"
                                     class="card-img-top"
                                     alt="Placeholder for CAD Image @j">
                                <div class="card-body text-center">
                                    <p class="card-text">Item @j</p>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        }
    </div>
</body>
</html>

