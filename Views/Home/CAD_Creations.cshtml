<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale= 1.0">
    <title>CAD Creations</title>
    <link rel="stylesheet" href="/css/3d_creations.css">
</head>

    <body>

        <div class="banner">
            <div class="banner-bg"></div>
            <div class="banner-content">
                <h1>Artistic Expressions through various Mediums</h1>
                <p>Explore the topics below to learn more, and have fun!</p>
            </div>
        </div>

        <div class="card-carousel">
            <div class="card-container">
                <div class="cards-row">
                    <div class="cards">
                        <div class="card-photo">
                            <img src="/Website_Logos/Csharp.png" alt="Photo 1">
                        </div>
                        <div class="card-content">
                            <p>C#<br />Object-Oriented Programming (OOP)<br />Foundations and Structures</p>
                        </div>
                    </div>
                </div>

                <div class="cards-row">
                    <div class="cards">
                        <div class="card-photo">
                            <img src="/Website_Logos/GitHub.png" alt="Photo 2">
                        </div>
                        <div class="card-content">
                            <p>Version Control Systems (VC)<br />GitHub and Git<br />Source Control<br />Merge/Branch/Commit</p>
                        </div>
                    </div>
                </div>

                <div class="cards-row">
                    <div class="cards">
                        <div class="card-photo">
                            <img src="/Website_Logos/MVC.png" alt="Photo 3">
                        </div>
                        <div class="card-content">
                            <p>Model View Controler (MVC) Architecture<br />Web Development Fundamentals<br />Entity Framework<br />ASP.NET</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </body>
</html>

